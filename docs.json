{
  "$schema": "https://mintlify.com/docs.json",
  "name": "FormBharo",
  "theme": "luma",
  "logo": {
    "light": "/logo/formbharo.svg",
    "dark": "/logo/formbharo.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#1be39b",
    "light": "#0c8c5c",
    "dark": "#99bbb0"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open FormBharo",
      "href": "https://formbharo.artpark.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "getting-started/what-is-formbharo",
              "getting-started/api-keys",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/agents",
              "concepts/calls",
              "concepts/answers"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/build-an-agent",
              "guides/run-a-call",
              "guides/poll-for-finished-calls",
              "guides/read-the-analytics"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/agent-configuration",
              "reference/question-types",
              "reference/validation",
              "reference/retries",
              "reference/branching",
              "reference/conventions",
              "reference/errors",
              "reference/gotchas"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
