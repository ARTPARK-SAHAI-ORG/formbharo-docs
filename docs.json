{
  "$schema": "https://mintlify.com/docs.json",
  "name": "FormBharo",
  "theme": "mint",
  "logo": {
    "light": "/logo/formbharo.svg",
    "dark": "/logo/formbharo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#1be39b",
    "light": "#0c8c5c",
    "dark": "#0c8c5c"
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to us",
        "href": "mailto:aman.dalmia@artpark.in,jigar@artpark.in,nihar@artpark.in?subject=Interested%20in%20FormBharo"
      },
      {
        "label": "Changelog",
        "href": "https://formbharo.artpark.ai/changelog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try now",
      "href": "https://formbharo.artpark.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/build-an-agent",
              "guides/run-a-call",
              "guides/poll-for-finished-calls",
              "guides/read-the-analytics",
              "guides/pdf-to-form"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/agent-config-schema"
            ]
          }
        ]
      },
      {
        "tab": "Agents",
        "groups": [
          {
            "group": "AI agents",
            "pages": [
              "agents/skills",
              "getting-started/api-keys"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/openapi.json"
          }
        ]
      },
      {
        "tab": "Use Cases",
        "groups": [
          {
            "group": "Browse use cases",
            "pages": [
              "use-cases/armman"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
