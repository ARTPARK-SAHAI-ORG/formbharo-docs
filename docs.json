{
  "$schema": "https://mintlify.com/docs.json",
  "name": "FormBharo",
  "theme": "luma",
  "logo": {
    "light": "/logo/formbharo.svg",
    "dark": "/logo/formbharo.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#1be39b",
    "light": "#0c8c5c",
    "dark": "#99bbb0"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open FormBharo",
      "href": "https://formbharo.artpark.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "getting-started/what-is-formbharo",
              "getting-started/api-keys",
              "getting-started/quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/agents",
              "concepts/calls",
              "concepts/answers"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/build-an-agent",
              "guides/run-a-call",
              "guides/poll-for-finished-calls",
              "guides/read-the-analytics"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/agent-configuration",
              "reference/question-types",
              "reference/validation",
              "reference/retries",
              "reference/branching",
              "reference/conventions",
              "reference/errors",
              "reference/gotchas"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "api-reference/agents/list-agents",
              "api-reference/agents/create-agent",
              "api-reference/agents/get-agent",
              "api-reference/agents/update-agent",
              "api-reference/agents/delete-agent",
              "api-reference/agents/duplicate-agent",
              "api-reference/agents/get-agent-public",
              "api-reference/agents/update-agent-config",
              "api-reference/agents/get-agent-access",
              "api-reference/agents/update-agent-access",
              "api-reference/agents/move-agent-workspace"
            ]
          },
          {
            "group": "Agent Versions",
            "pages": [
              "api-reference/versions/list-versions",
              "api-reference/versions/get-version",
              "api-reference/versions/get-version-diff",
              "api-reference/versions/restore-version",
              "api-reference/versions/diff-preview",
              "api-reference/versions/config-diff-preview"
            ]
          },
          {
            "group": "Calls",
            "pages": [
              "api-reference/calls/list-conversations",
              "api-reference/calls/get-form-data",
              "api-reference/calls/update-form-data",
              "api-reference/calls/get-transcript"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "api-reference/analytics/list-all-conversations",
              "api-reference/analytics/agent-analytics",
              "api-reference/analytics/workspace-analytics"
            ]
          },
          {
            "group": "Workspaces",
            "pages": [
              "api-reference/workspaces/list-workspaces",
              "api-reference/workspaces/create-workspace",
              "api-reference/workspaces/get-workspace",
              "api-reference/workspaces/rename-workspace",
              "api-reference/workspaces/add-member",
              "api-reference/workspaces/remove-member"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}
